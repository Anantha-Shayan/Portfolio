# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# Site URL (used for OG / canonical meta tags in production)
NEXT_PUBLIC_SITE_URL=https://ananthadev.online

# ── Contact form ────────────────────────────────────────────────
# A message counts as delivered if at least one channel below accepts it.
# Set both in production, so a spam-filtered email never means a lost message.

# Channel 1: email through Resend (https://resend.com)
RESEND_API_KEY=re_your_key_here
CONTACT_TO_EMAIL=you@example.com
# Verify your domain in Resend and send from it, for example:
#   CONTACT_FROM_EMAIL="Portfolio <contact@ananthadev.online>"
# The default sender (onboarding@resend.dev) only delivers to your own Resend account address.
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"

# Channel 2 (optional but recommended): a Discord or Slack incoming-webhook URL
CONTACT_WEBHOOK_URL=

# Local testing only (ignored in production): accept submissions without sending anything
# CONTACT_DRY_RUN=1
